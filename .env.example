# ==========================================
# Jai Thuthiksha Fashion Environment Config
# ==========================================

# Backend Server Port (Default: 5000)
PORT=5000

# Environment Mode (development | production)
NODE_ENV=production

# JWT Authentication Secret Key
JWT_SECRET=jtf_production_jwt_secret_key_2026

# Admin Master Password (Default: Admin@JTF2026)
ADMIN_PASSWORD=Admin@JTF2026

# Optional Supabase Database Connection
# (Project falls back automatically to local server/data/db.json if omitted)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Client Frontend Base URL (For CORS allowed origins)
CLIENT_URL=https://www.jaithuthikshafashion.online

# Vite Frontend API Base URL (Used in frontend build)
VITE_API_BASE_URL=http://localhost:5000/api
